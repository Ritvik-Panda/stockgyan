/* =========================================================
   HELPERS
   ========================================================= */

function num(value){
  if(value === null || value === undefined || value === ""){
    return null;
  }

  const n = Number(
    String(value)
      .replace(/,/g,"")
      .replace(/%/g,"")
      .trim()
  );

  return Number.isFinite(n) ? n : null;
}

function escapeHtml(value){
  return String(value ?? "")
    .replace(/&/g,"&amp;")
    .replace(/</g,"&lt;")
    .replace(/>/g,"&gt;")
    .replace(/"/g,"&quot;")
    .replace(/'/g,"&#039;");
}

function scoreLabel(score){
  if(!Number.isFinite(score)){
    return "Insufficient Data";
  }

  if(score >= 80) return "Excellent";
  if(score >= 65) return "Good";
  if(score >= 50) return "Average";
  return "Weak";
}

function scoreClass(score){
  if(!Number.isFinite(score)) return "status-unavailable";
  if(score >= 80) return "score-excellent";
  if(score >= 65) return "score-good";
  if(score >= 50) return "score-average";
  return "score-weak";
}

function formatNumber(value, decimals=2){
  return Number.isFinite(value)
    ? value.toFixed(decimals)
    : "—";
}

function formatPercent(value){
  if(!Number.isFinite(value)) return "—";
  return `${value.toFixed(2)}%`;
}

function formatPE(value){
  if(!Number.isFinite(value)) return "—";
  return value.toFixed(2);
}

/* =========================================================
   LOAD NSE UNIVERSE
   ========================================================= */

async function loadUniverse(){
  const status = document.getElementById("status");

  try{
    status.textContent = "Loading NSE universe...";

    const response = await fetch(
      UNIVERSE_API,
      {
        cache:"no-store",
        headers:{Accept:"application/json"}
      }
    );

    if(!response.ok){
      throw new Error(`Universe request failed: ${response.status}`);
    }

    const payload = await response.json();

    const rows =
      Array.isArray(payload)
        ? payload
        : Array.isArray(payload.data)
          ? payload.data
          : Array.isArray(payload.stocks)
            ? payload.stocks
            : [];

    universe = rows;

    document.getElementById("universeCount").textContent =
      universe.length.toLocaleString();

    status.textContent =
      `NSE universe loaded: ${universe.length.toLocaleString()} stocks. Loading stored Health data...`;

  }catch(error){
    console.error("Universe load error:", error);

    universe = [];

    document.getElementById("universeCount").textContent = "—";

    status.textContent =
      "NSE universe could not be loaded. Stored Health data can still be displayed.";
  }

  renderTable();
}

/* =========================================================
   LOAD HEALTH DATA FROM D1
   ========================================================= */

async function loadHealthData(){
  const status = document.getElementById("status");

  try{
    status.textContent =
      "Loading stored StockGyan Health data...";

    const response = await fetch(
      HEALTH_DATA_API,
      {
        cache:"no-store",
        headers:{Accept:"application/json"}
      }
    );

    if(!response.ok){
      throw new Error(`Health data request failed: ${response.status}`);
    }

    const payload = await response.json();

    if(payload.status !== "success"){
      throw new Error(
        payload.message || "Health data API returned an error"
      );
    }

    const rows =
      Array.isArray(payload.data)
        ? payload.data
        : [];

    healthData = rows.map(row => ({
      symbol: row.symbol || "",
      name: row.company_name || row.symbol || "",
      isin: row.isin || "",
      exchange: row.exchange || "NSE",

      healthScore: num(row.health_score),

      label:
        row.quality_label ||
        (
          Number.isFinite(num(row.health_score))
            ? scoreLabel(num(row.health_score))
            : "Insufficient Data"
        ),

      businessQuality: num(row.business_quality),

      roce: num(row.roce),

      roe: num(row.roe),

      pe: num(row.pe_ratio),

      earningsGrowth: num(row.earnings_growth),

      financialScore: null,

      debtEquity: num(row.debt_equity),

      profitability: num(row.profitability),

      // Optional strategy metrics: read only if already supplied by the existing API.
      roic: num(row.roic ?? row.ROIC ?? row.return_on_invested_capital ?? row.returnOnInvestedCapital),
      earningsYield: num(row.earnings_yield ?? row.earningsYield ?? row.ey),
      bookValue: num(row.book_value ?? row.bookValue ?? row.bookvalue),
      marketCap: num(row.market_cap ?? row.market_capitalization ?? row.marketCap ?? row.marketCapitalization),
      salesGrowth: num(row.sales_growth ?? row.salesGrowth ?? row.revenue_growth),
      salesGrowth10Y: num(row.sales_growth_10_years ?? row.sales_growth_10y ?? row.salesGrowth10Years ?? row.sales_growth_10_year),
      avgRoce10Y: num(row.average_roce_10_years ?? row.avg_roce_10y ?? row.averageROCE10Years ?? row.roce_10y),
      piotroskiScore: num(row.piotroski_score ?? row.piotroskiScore ?? row.piotroski_f_score ?? row.f_score),

      availableMetrics: Number(row.available_metrics || 0),

      dataStatus: row.data_status || "pending",

      updatedAt: row.updated_at || ""
    }));

    document.getElementById("dataCount").textContent =
      healthData.length.toLocaleString();

    status.textContent =
      `Loaded ${healthData.length.toLocaleString()} stored Health records from StockGyan D1. No live Upstox requests are made by this screener.`;

    updateStats();

  }catch(error){
    console.error("Health D1 load error:", error);

    healthData = [];

    document.getElementById("dataCount").textContent = "0";

    status.textContent =
      "Unable to load stored Health data from StockGyan D1.";

    updateStats();
  }

  renderTable();
}

/* =========================================================
   STRATEGY SCANS — CLIENT-SIDE ONLY, NO EXTRA API/D1 CALLS
   ========================================================= */

const strategyNames = {
  health:"Health Screener",
  quality:"Quality",
  value:"Value",
  growth:"Growth",
  lowDebt:"Low Debt",
  coffeeCan:"Coffee Can",
  magicFormula:"Magic Formula",
  piotroski:"Piotroski F-Score > 7"
};

function metricAvailable(v){ return Number.isFinite(v); }
function matchesStrategy(row, strategy){
  const gt = (v, threshold) => metricAvailable(v) && v > threshold;
  switch(strategy){
    case "quality":
      return gt(row.roce, 20) && gt(row.roe, 15);
    case "value":
      return metricAvailable(row.pe) && row.pe > 0 && row.pe <= 15;
    case "growth":
      return gt(row.earningsGrowth, 10);
    case "lowDebt":
      return metricAvailable(row.debtEquity) && row.debtEquity >= 0 && row.debtEquity < 0.5;
    case "coffeeCan":
      return gt(row.salesGrowth, readThreshold("f_sales_min", 10)) &&
        gt(row.salesGrowth10Y, readThreshold("f_sales10_min", 10)) &&
        gt(row.roe, 15) &&
        gt(row.avgRoce10Y, readThreshold("f_roce10_min", 15)) &&
        gt(row.marketCap, readThreshold("f_mcap_min", 1000));
    case "magicFormula":
      return gt(row.roic, readThreshold("f_roic_min", 25)) &&
        gt(row.earningsYield, readThreshold("f_ey_min", 15)) &&
        gt(row.bookValue, readThreshold("f_bv_min", 0)) &&
        gt(row.marketCap, readThreshold("f_mcap_min", 500));
    case "piotroski":
      return gt(row.piotroskiScore, 7);
    default:
      return true;
  }
}
function readThreshold(id, fallback){
  const el = document.getElementById(id);
  if(!el || el.value.trim() === "") return fallback;
  const value = Number(el.value);
  return Number.isFinite(value) ? value : fallback;
}
function setStrategy(strategy){
  activeStrategy = strategyNames[strategy] ? strategy : "health";
  if(activeStrategy === "magicFormula"){
    document.getElementById("f_roic_min").value = 25;
    document.getElementById("f_ey_min").value = 15;
    document.getElementById("f_bv_min").value = 0;
    document.getElementById("f_mcap_min").value = 500;
  }
  document.querySelectorAll(".strategy-btn").forEach(btn=>{
    btn.classList.toggle("active", btn.dataset.strategy === activeStrategy);
  });
  const descriptions = {
    health:"Existing Health Score filters and methodology.",
    quality:"Illustrative Quality scan: ROCE > 20% and ROE > 15%.",
    value:"Illustrative Value scan: positive P/E up to 15. This is a simple heuristic, not a sector-adjusted valuation.",
    growth:"Illustrative Growth scan: earnings growth > 10%.",
    lowDebt:"Low Debt scan: debt-to-equity below 0.5.",
    coffeeCan:"Coffee Can: Sales Growth > 10%, 10-year Sales Growth > 10%, ROE > 15%, 10-year average ROCE > 15%, and market cap > ₹1,000 Cr. Missing metrics do not qualify.",
    magicFormula:"Magic Formula snapshot (Screener.in, 16 Oct 2026): ROIC > 25%, earnings yield > 15%, book value > 0, and market cap > ₹500 Cr. Uses the supplied report snapshot, not live prices.",
    piotroski:"Piotroski scan: F-Score > 7 (scores 8 or 9). Uses an existing score field only; it does not calculate an F-Score."
  };
  document.getElementById("strategyDescription").textContent = descriptions[activeStrategy];
  const healthFilter = document.getElementById("healthFilter");
  if(healthFilter) healthFilter.disabled = activeStrategy === "magicFormula";
  const sortSelect = document.getElementById("sortBy");
  if(sortSelect && activeStrategy === "magicFormula"){
    sortSelect.options[0].textContent = "ROIC ↓";
    sortSelect.options[1].textContent = "ROIC ↑";
    sortSelect.options[2].textContent = "ROCE ↓";
    sortSelect.options[3].textContent = "Earnings Yield ↓";
    sortSelect.options[4].textContent = "P/E ↓";
    sortSelect.options[5].textContent = "Quarterly Sales Growth ↓";
    sortSelect.options[6].textContent = "Company A-Z";
  } else if(sortSelect){
    sortSelect.options[0].textContent = "Health Score ↓";
    sortSelect.options[1].textContent = "Health Score ↑";
    sortSelect.options[2].textContent = "ROE ↓";
    sortSelect.options[3].textContent = "ROCE ↓";
    sortSelect.options[4].textContent = "P/E ↑";
    sortSelect.options[5].textContent = "Earnings Growth ↓";
    sortSelect.options[6].textContent = "Symbol A-Z";
  }
  document.getElementById("strategyStatus").textContent =
    activeStrategy === "magicFormula"
      ? `Magic Formula uses ${magicFormulaData.length} supplied Screener.in rows dated ${MAGIC_FORMULA_SNAPSHOT.sourceReportDate}. This is a report snapshot, not live market data; no API or D1 reads are made for this scan.`
      : `Selected: ${strategyNames[activeStrategy]}. Only metrics already returned by the current API are used; no new API or D1 reads are made.`;
  updateStats();
  renderTable();
}
function exportFilteredHealthCSV(){
  const rows = getFilteredData();
  const columns = [
    ["Symbol","symbol"],["Company","name"],["Health Score","healthScore"],
    ["Business Quality","businessQuality"],["ROCE","roce"],["ROE","roe"],["P/E","pe"],
    ["Earnings Growth","earningsGrowth"],["Debt/Equity","debtEquity"],["Profitability","profitability"],
    ["ROIC","roic"],["Earnings Yield","earningsYield"],["Book Value","bookValue"],
    ["Market Cap","marketCap"],["Sales Growth","salesGrowth"],["Sales Growth 10Y","salesGrowth10Y"],
    ["Average ROCE 10Y","avgRoce10Y"],["Piotroski F-Score","piotroskiScore"],["Data Status","dataStatus"]
  ];
  const csvCell = v => `"${String(v ?? "").replace(/"/g,'""')}"`;
  const csv = [columns.map(c=>csvCell(c[0])).join(","), ...rows.map(row=>columns.map(c=>csvCell(row[c[1]] ?? "")).join(","))].join("\r\n");
  const blob = new Blob(["\ufeff",csv],{type:"text/csv;charset=utf-8;"});
  const url = URL.createObjectURL(blob);
  const a = document.createElement("a");
  a.href = url;
  a.download = `stockgyan-${activeStrategy}-scan.csv`;
  document.body.appendChild(a);
  a.click();
  a.remove();
  setTimeout(()=>URL.revokeObjectURL(url),1000);
}
document.querySelectorAll(".strategy-btn").forEach(btn=>{
  btn.addEventListener("click",()=>setStrategy(btn.dataset.strategy));
});
document.getElementById("applyStrategyFilters").addEventListener("click",()=>{
  updateStats(); renderTable();
});
document.getElementById("exportHealthCsv").addEventListener("click",exportFilteredHealthCSV);

/* =========================================================
   FILTER / SORT
   ========================================================= */

function getFilteredData(){
  if(activeStrategy === "magicFormula"){
    const search = String(document.getElementById("search").value || "").trim().toLowerCase();
    const minRoic = readThreshold("f_roic_min", 25);
    const minYield = readThreshold("f_ey_min", 15);
    const minBook = readThreshold("f_bv_min", 0);
    const minMarketCap = readThreshold("f_mcap_min", 500);
    let rows = magicFormulaData.filter(row => {
      const matchesSearch = !search || row.name.toLowerCase().includes(search);
      return matchesSearch &&
        Number.isFinite(row.roic) && row.roic > minRoic &&
        Number.isFinite(row.earningsYield) && row.earningsYield > minYield &&
        Number.isFinite(row.bookValue) && row.bookValue > minBook &&
        Number.isFinite(row.marketCap) && row.marketCap > minMarketCap;
    });
    const sort = document.getElementById("sortBy").value;
    const sortKeys = {
      healthDesc: "roic", healthAsc: "roic",
      roeDesc: "roce", roceDesc: "earningsYield",
      peAsc: "pe", growthDesc: "quarterlySalesChange", symbol: "name"
    };
    const key = sortKeys[sort] || "roic";
    rows.sort((a,b) => {
      if(key === "name") return a.name.localeCompare(b.name);
      const av = a[key], bv = b[key];
      if(!Number.isFinite(av)) return 1;
      if(!Number.isFinite(bv)) return -1;
      return sort === "healthAsc" ? av - bv : bv - av;
    });
    return rows;
  }
  const search =
    String(
      document.getElementById("search").value || ""
    )
    .trim()
    .toLowerCase();

  const filter =
    document.getElementById("healthFilter").value;

  const sort =
    document.getElementById("sortBy").value;

  let rows = healthData.filter(row => {

    const matchesSearch =
      !search ||
      String(row.symbol).toLowerCase().includes(search) ||
      String(row.name).toLowerCase().includes(search);

    if(!matchesSearch) return false;

    if(!matchesStrategy(row, activeStrategy)) return false;

    if(filter === "all"){
      return true;
    }

    const score = row.healthScore;

    if(!Number.isFinite(score)){
      return false;
    }

    if(filter === "80") return score >= 80;
    if(filter === "65") return score >= 65;
    if(filter === "50") return score >= 50;

    if(filter === "0") return score < 50;

    return true;
  });

  rows.sort((a,b) => {

    const av = keyValue(a, sort);
    const bv = keyValue(b, sort);

    if(typeof av === "string" || typeof bv === "string"){
      return String(av).localeCompare(String(bv));
    }

    const aValid = Number.isFinite(av);
    const bValid = Number.isFinite(bv);

    if(!aValid && !bValid) return 0;
    if(!aValid) return 1;
    if(!bValid) return -1;

    return sort === "healthAsc" ? av - bv : bv - av;
  });

  return rows;
}

function keyValue(row, sort){
  switch(sort){
    case "healthAsc":
    case "healthDesc":
      return row.healthScore;

    case "roeDesc":
      return row.roe;

    case "roceDesc":
      return row.roce;

    case "peAsc":
      return row.pe;

    case "growthDesc":
      return row.earningsGrowth;

    case "symbol":
      return String(row.symbol || "");

    default:
      return row.healthScore;
  }
}

/* =========================================================
   STATS
   ========================================================= */

function updateStats(){
  if(activeStrategy === "magicFormula"){
    document.getElementById("excellentCount").textContent = "—";
    document.getElementById("goodCount").textContent = "—";
    document.getElementById("displayedCount").textContent = getFilteredData().length.toLocaleString();
    return;
  }
  const excellent =
    healthData.filter(
      row => Number.isFinite(row.healthScore) &&
             row.healthScore >= 80
    ).length;

  const good =
    healthData.filter(
      row => Number.isFinite(row.healthScore) &&
             row.healthScore >= 65 &&
             row.healthScore < 80
    ).length;

  document.getElementById("excellentCount").textContent =
    excellent.toLocaleString();

  document.getElementById("goodCount").textContent =
    good.toLocaleString();

  const displayed =
    getFilteredData().length;

  document.getElementById("displayedCount").textContent =
    displayed.toLocaleString();
}

/* =========================================================
   RENDER TABLE
   ========================================================= */

function renderTable(){
  const tbody =
    document.getElementById("stockTable");

  if(!tbody) return;

  const rows = getFilteredData();
  const title = document.getElementById("tableTitle");
  const head = document.getElementById("stockTableHead");
  const resultInfo = document.getElementById("resultInfo");

  if(activeStrategy === "magicFormula"){
    if(head) head.innerHTML = `<tr>
      <th>#</th><th>Company</th><th>CMP (₹)</th><th>P/E</th><th>Market Cap (₹ Cr)</th>
      <th>Div. Yield %</th><th>Net Profit Qtr (₹ Cr)</th><th>Qtr Profit Change %</th>
      <th>Sales Qtr (₹ Cr)</th><th>Qtr Sales Change %</th><th>ROCE %</th>
      <th>PAT 12M (₹ Cr)</th><th>ROIC %</th><th>Earnings Yield %</th><th>Book Value (₹)</th>
    </tr>`;
    if(title) title.textContent = "StockGyan Magic Formula — Screener.in Snapshot";
    document.getElementById("displayedCount").textContent = rows.length.toLocaleString();
    if(resultInfo) resultInfo.textContent = `${rows.length} companies matching all four Magic Formula rules · Report date: ${MAGIC_FORMULA_SNAPSHOT.sourceReportDate}`;
    if(!rows.length){
      tbody.innerHTML = `<tr><td colspan="15" class="empty">No companies match the current Magic Formula thresholds.</td></tr>`;
      return;
    }
    tbody.innerHTML = rows.map(row => `<tr>
      <td>${row.snapshotRow}</td><td class="company">${escapeHtml(row.name)}</td>
      <td>${formatNumber(row.cmp)}</td><td>${formatPE(row.pe)}</td>
      <td>${formatNumber(row.marketCap)}</td><td>${formatNumber(row.dividendYield)}</td>
      <td>${formatNumber(row.netProfitQuarter)}</td><td>${formatNumber(row.quarterlyProfitChange)}</td>
      <td>${formatNumber(row.salesQuarter)}</td><td>${formatNumber(row.quarterlySalesChange)}</td>
      <td>${formatPercent(row.roce)}</td><td>${formatNumber(row.pat12m)}</td>
      <td><strong>${formatPercent(row.roic)}</strong></td><td><strong>${formatPercent(row.earningsYield)}</strong></td>
      <td>${formatNumber(row.bookValue)}</td>
    </tr>`).join("");
    return;
  }

  if(head) head.innerHTML = `<tr>
    <th>Symbol</th><th>Company</th><th>Health Score</th><th>Business Quality</th><th>ROCE</th>
    <th>ROE</th><th>P/E</th><th>Earnings Growth</th><th>Financial Strength</th><th>Profitability</th>
    <th>ROIC</th><th>Earnings Yield</th><th>Book Value</th><th>Market Cap</th><th>Sales Growth</th>
    <th>Sales Growth 10Y</th><th>Avg ROCE 10Y</th><th>Piotroski</th><th>Data</th>
  </tr>`;

  if(title) title.textContent = `StockGyan ${strategyNames[activeStrategy] || "Health"} Stocks`;

  document.getElementById("displayedCount").textContent =
    rows.length.toLocaleString();

  document.getElementById("resultInfo").textContent =
    `${rows.length.toLocaleString()} stored Health records`;

  if(!rows.length){
    tbody.innerHTML = `
      <tr>
        <td colspan="19" class="empty">
          ${
            healthData.length
              ? "No stocks match the current filters."
              : "No stored Health data available yet."
          }
        </td>
      </tr>
    `;
    return;
  }

  tbody.innerHTML = rows.map(row => {

    const score = row.healthScore;

    const label =
      row.label ||
      scoreLabel(score);

    const scoreText =
      Number.isFinite(score)
        ? score.toFixed(2)
        : "—";

    const businessText =
      Number.isFinite(row.businessQuality)
        ? row.businessQuality.toFixed(2)
        : "—";

    const financialText =
      Number.isFinite(row.financialScore)
        ? row.financialScore.toFixed(2)
        : "—";

    const profitabilityText =
      formatPercent(row.profitability);

    let dataClass = "status-unavailable";
    let dataText = "Pending";

    if(row.dataStatus === "complete"){
      dataClass = "status-ready";
      dataText = `${row.availableMetrics}/6`;
    }
    else if(row.availableMetrics > 0){
      dataClass = "status-partial";
      dataText = `${row.availableMetrics}/6`;
    }

    const growthClass =
      Number.isFinite(row.earningsGrowth)
        ? row.earningsGrowth >= 0
          ? "positive"
          : "negative"
        : "muted";

    return `
      <tr>

        <td class="symbol">
          ${escapeHtml(row.symbol)}
        </td>

        <td class="company" title="${escapeHtml(row.name)}">
          ${escapeHtml(row.name)}
        </td>

        <td>
          <span class="score ${scoreClass(score)}">
            ${scoreText}
          </span>
          <div class="muted" style="font-size:10px;margin-top:3px;">
            ${escapeHtml(label)}
          </div>
        </td>

        <td>
          ${businessText}
        </td>

        <td>
          ${
            Number.isFinite(row.roce)
              ? formatPercent(row.roce)
              : "—"
          }
        </td>

        <td>
          ${
            Number.isFinite(row.roe)
              ? formatPercent(row.roe)
              : "—"
          }
        </td>

        <td>
          ${formatPE(row.pe)}
        </td>

        <td class="${growthClass}">
          ${formatPercent(row.earningsGrowth)}
        </td>

        <td>
          ${
            financialText !== "—"
              ? financialText
              : Number.isFinite(row.debtEquity)
                ? `D/E ${row.debtEquity.toFixed(2)}`
                : "—"
          }
        </td>

        <td>
          ${profitabilityText}
        </td>
        <td>${formatPercent(row.roic)}</td>
        <td>${formatPercent(row.earningsYield)}</td>
        <td>${formatNumber(row.bookValue)}</td>
        <td>${formatNumber(row.marketCap)}</td>
        <td>${formatPercent(row.salesGrowth)}</td>
        <td>${formatPercent(row.salesGrowth10Y)}</td>
        <td>${formatPercent(row.avgRoce10Y)}</td>
        <td>${formatNumber(row.piotroskiScore,0)}</td>

        <td>
          <span class="status-pill ${dataClass}">
            ${dataText}
          </span>
        </td>

      </tr>
    `;
  }).join("");
}

/* =========================================================
   FILTER RESET
   ========================================================= */

function clearFilters(){
  document.getElementById("search").value = "";
  document.getElementById("healthFilter").value = "all";
  document.getElementById("sortBy").value = "healthDesc";
  setStrategy("health");

  updateStats();
  renderTable();
}

/* =========================================================
   EVENTS
   ========================================================= */

document.getElementById("search")
  .addEventListener("input", function(){
    updateStats();
    renderTable();
  });

document.getElementById("healthFilter")
  .addEventListener("change", function(){
    updateStats();
    renderTable();
  });

document.getElementById("sortBy")
  .addEventListener("change", function(){
    updateStats();
    renderTable();
});

/* =========================================================
   INITIAL LOAD
   ========================================================= */

(async function init(){

  document.getElementById("status").textContent =
    "Loading StockGyan Health data...";

  await Promise.all([
    loadUniverse(),
    loadHealthData()
  ]);

})();
</script>

