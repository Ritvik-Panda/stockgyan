<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>StockGyan Health Screener</title>

<style>
*{
  box-sizing:border-box;
}

body{
  margin:0;
  font-family:Arial,Helvetica,sans-serif;
  background:#f4f7fb;
  color:#172033;
}

header{
  background:linear-gradient(135deg,#082a63,#0b478f);
  color:#fff;
  padding:24px 20px;
}

.header-inner,
main{
  max-width:1500px;
  margin:auto;
}

.brand{
  font-size:29px;
  font-weight:800;
}

.brand span{
  color:#f28c28;
}

.subtitle{
  margin-top:6px;
  font-size:14px;
  opacity:.92;
}

main{
  padding:22px 16px 40px;
}

.stats{
  display:grid;
  grid-template-columns:repeat(5,1fr);
  gap:14px;
  margin-bottom:18px;
}

.stat,
.controls,
.table-container,
.methodology{
  background:#fff;
  border-radius:12px;
  box-shadow:0 2px 10px rgba(0,0,0,.07);
  border:1px solid #e7edf5;
}

.stat{
  padding:18px;
}

.stat-title{
  font-size:12px;
  color:#697386;
  margin-bottom:8px;
}

.stat-value{
  font-size:25px;
  font-weight:800;
  color:#082a63;
}

.controls{
  padding:16px;
  margin-bottom:18px;
}

.control-row{
  display:flex;
  gap:10px;
  flex-wrap:wrap;
  align-items:center;
}

input,
select,
button{
  font-family:inherit;
}

input[type=text],
select{
  height:42px;
  border:1px solid #ccd5e2;
  border-radius:8px;
  padding:0 12px;
  background:#fff;
  font-size:14px;
}

#search{
  flex:1;
  min-width:250px;
}

button{
  height:42px;
  border:0;
  border-radius:8px;
  padding:0 16px;
  cursor:pointer;
  font-weight:700;
  background:#082a63;
  color:#fff;
}

button:hover{
  opacity:.92;
}


.btn-orange{
  background:#f28c28;
}

.btn-light{
  background:#edf2f8;
  color:#17335f;
}

button:disabled{
  opacity:.55;
  cursor:not-allowed;
}

.status{
  margin-top:12px;
  font-size:13px;
  color:#536174;
}



.table-container{
  overflow:hidden;
}

.table-header{
  padding:15px 16px;
  background:#f8fafc;
  border-bottom:1px solid #e7edf5;
  display:flex;
  justify-content:space-between;
  align-items:center;
  gap:10px;
}

.table-title{
  font-size:18px;
  font-weight:800;
  color:#082a63;
}

.table-wrap{
  overflow:auto;
  max-height:72vh;
}

table{
  width:100%;
  border-collapse:collapse;
  min-width:1250px;
}

th{
  position:sticky;
  top:0;
  z-index:2;
  background:#082a63;
  color:#fff;
  padding:12px 10px;
  text-align:right;
  font-size:12px;
  white-space:nowrap;
}

th:first-child,
th:nth-child(2){
  text-align:left;
}

td{
  padding:11px 10px;
  border-bottom:1px solid #edf1f6;
  font-size:13px;
  text-align:right;
  white-space:nowrap;
}

td:first-child,
td:nth-child(2){
  text-align:left;
}

tr:hover td{
  background:#f7faff;
}

.symbol{
  font-weight:800;
  color:#082a63;
}

.company{
  color:#667085;
  max-width:250px;
  overflow:hidden;
  text-overflow:ellipsis;
}

.score{
  display:inline-flex;
  align-items:center;
  justify-content:center;
  min-width:58px;
  padding:5px 9px;
  border-radius:20px;
  font-weight:800;
}

.score-excellent{
  background:#dff7e8;
  color:#067647;
}

.score-good{
  background:#e9f7df;
  color:#477a16;
}

.score-average{
  background:#fff3d6;
  color:#a15c00;
}

.score-weak{
  background:#fde4e4;
  color:#b42318;
}

.muted{
  color:#8a94a6;
}

.positive{
  color:#159447;
  font-weight:700;
}

.negative{
  color:#d83232;
  font-weight:700;
}

.status-pill{
  display:inline-block;
  padding:4px 8px;
  border-radius:15px;
  font-size:11px;
  font-weight:700;
}

.status-ready{
  background:#dff7e8;
  color:#067647;
}

.status-partial{
  background:#fff3d6;
  color:#a15c00;
}

.status-unavailable{
  background:#fde4e4;
  color:#b42318;
}

.empty{
  padding:60px 20px;
  text-align:center;
  color:#697386;
}

.methodology{
  margin-top:18px;
  padding:16px;
}

.methodology-title{
  font-size:16px;
  font-weight:800;
  color:#082a63;
  margin-bottom:8px;
}

.methodology-text{
  font-size:12px;
  color:#697386;
  line-height:1.6;
}

@media(max-width:1000px){
  .stats{
    grid-template-columns:repeat(2,1fr);
  }
}

@media(max-width:600px){
  .brand{
    font-size:23px;
  }

  .stats{
    grid-template-columns:1fr;
  }

  main{
    padding:15px 10px 30px;
  }
}

.strategy-btn{background:#edf2f8;color:#17335f;border:1px solid #d7e0ec}
.strategy-btn.active{background:#082a63;color:#fff;border-color:#082a63}
#strategyPanel label{display:flex;align-items:center;gap:6px;font-size:12px;color:#536174;flex-wrap:wrap}
#strategyPanel input[type=number]{height:36px;border:1px solid #ccd5e2;border-radius:7px;padding:0 8px;font:inherit;color:#172033;min-width:75px}
#strategyPanel .control-row{align-items:center}
@media(max-width:600px){#strategyPanel label{width:100%;justify-content:space-between}#strategyPanel input[type=number]{flex:1}}

</style>
</head>

<body>

<header>
  <div class="header-inner">

    <div class="brand">
      Stock<span>Gyan</span> Health Screener
    </div>

    <div class="subtitle">
      Fundamental Health Analysis • NSE Universe • Powered by StockGyan Health Data
    </div>

  </div>
</header>

<main>

  <!-- =========================
       STATS
  ========================== -->

  <section class="stats">

    <div class="stat">
      <div class="stat-title">NSE Universe</div>
      <div class="stat-value" id="universeCount">0</div>
    </div>

    <div class="stat">
      <div class="stat-title">Health Data Loaded</div>
      <div class="stat-value" id="dataCount">0</div>
    </div>

    <div class="stat">
      <div class="stat-title">Excellent</div>
      <div class="stat-value" id="excellentCount">0</div>
    </div>

    <div class="stat">
      <div class="stat-title">Good</div>
      <div class="stat-value" id="goodCount">0</div>
    </div>

    <div class="stat">
      <div class="stat-title">Displayed</div>
      <div class="stat-value" id="displayedCount">0</div>
    </div>

  </section>


  <!-- =========================
       CONTROLS
  ========================== -->

  <section class="controls">

    <div class="control-row">

      <input
        id="search"
        type="text"
        placeholder="Search stock symbol or company name..."
      >

      <select id="healthFilter">
        <option value="all">All Health Scores</option>
        <option value="80">80+ Excellent</option>
        <option value="65">65+ Good</option>
        <option value="50">50+ Average</option>
        <option value="0">Below 50</option>
      </select>

      <select id="sortBy">

        <option value="healthDesc">
          Health Score ↓
        </option>

        <option value="healthAsc">
          Health Score ↑
        </option>

        <option value="roeDesc">
          ROE ↓
        </option>

        <option value="roceDesc">
          ROCE ↓
        </option>

        <option value="peAsc">
          P/E ↑
        </option>

        <option value="growthDesc">
          Earnings Growth ↓
        </option>

        <option value="symbol">
          Symbol A-Z
        </option>

      </select>

      <button
        id="loadUniverseBtn"
        onclick="loadUniverse()"
      >
        Refresh NSE
      </button>
<button
        class="btn-light"
        onclick="clearFilters()"
      >
        Clear
      </button>

    </div>

    <div class="status" id="status">
      Loading StockGyan Health Data...
    </div>
</section>

  <section class="controls" id="strategyPanel">
    <div style="font-size:18px;font-weight:800;color:#082a63;margin-bottom:8px;">Strategy Scans</div>
    <div class="control-row" style="margin-bottom:12px;">
      <button type="button" class="strategy-btn" data-strategy="health">Health Screener</button>
      <button type="button" class="strategy-btn" data-strategy="quality">Quality</button>
      <button type="button" class="strategy-btn" data-strategy="value">Value</button>
      <button type="button" class="strategy-btn" data-strategy="growth">Growth</button>
      <button type="button" class="strategy-btn" data-strategy="lowDebt">Low Debt</button>
      <button type="button" class="strategy-btn" data-strategy="coffeeCan">Coffee Can</button>
      <button type="button" class="strategy-btn" data-strategy="magicFormula">Magic Formula</button>
      <button type="button" class="strategy-btn" data-strategy="piotroski">Piotroski F-Score &gt; 7</button>
    </div>
    <div class="methodology-text" id="strategyDescription">
      Select a strategy. A stock qualifies only when all required metrics are available and satisfy the selected rules.
    </div>
    <div style="height:12px"></div>
    <div class="control-row">
      <label>ROIC min % <input id="f_roic_min" type="number" placeholder="25" style="width:100px"></label>
      <label>Earnings yield min % <input id="f_ey_min" type="number" placeholder="15" style="width:120px"></label>
      <label>Book value min <input id="f_bv_min" type="number" placeholder="0" style="width:100px"></label>
      <label>Market cap min (₹ Cr) <input id="f_mcap_min" type="number" value="500" placeholder="500" style="width:120px"></label>
      <label>Sales growth min % <input id="f_sales_min" type="number" placeholder="10" style="width:110px"></label>
      <label>10Y sales growth min % <input id="f_sales10_min" type="number" placeholder="10" style="width:130px"></label>
      <label>10Y avg ROCE min % <input id="f_roce10_min" type="number" placeholder="15" style="width:130px"></label>
      <button type="button" id="applyStrategyFilters" class="btn-orange">Apply thresholds</button>
      <button type="button" id="exportHealthCsv" class="btn-light">Export filtered CSV</button>
    </div>
    <div class="status" id="strategyStatus">Strategy filters use fields already returned by the existing Health Data API. No additional API calls are made.</div>
  </section>

  <!-- =========================
       TABLE
  ========================== -->

  <section class="table-container">

    <div class="table-header">

      <div class="table-title" id="tableTitle">
        StockGyan Health Stocks
      </div>

      <div id="resultInfo">
        Loading stored Health data...
      </div>

    </div>

    <div class="table-wrap">

      <table>

        <thead id="stockTableHead">

          <tr>

            <th>Symbol</th>

            <th>Company</th>

            <th>Health Score</th>

            <th>Business Quality</th>

            <th>ROCE</th>

            <th>ROE</th>

            <th>P/E</th>

            <th>Earnings Growth</th>

            <th>Financial Strength</th>

            <th>Profitability</th>
            <th>ROIC</th>
            <th>Earnings Yield</th>
            <th>Book Value</th>
            <th>Market Cap</th>
            <th>Sales Growth</th>
            <th>Sales Growth 10Y</th>
            <th>Avg ROCE 10Y</th>
            <th>Piotroski</th>
            <th>Data</th>

          </tr>

        </thead>

        <tbody id="stockTable">

          <tr>
            <td
              colspan="19"
              class="empty"
            >
              Loading NSE universe...
            </td>
          </tr>

        </tbody>

      </table>

    </div>

  </section>


  <!-- =========================
       METHODOLOGY
  ========================== -->

  <section class="methodology">

    <div class="methodology-title">
      StockGyan Health Score Methodology
    </div>

    <div class="methodology-text">

      <strong>Business Quality – 30%</strong>:
      ROE compared with the company's sector benchmark.

      <br>

      <strong>ROCE – 20%</strong>:
      ROCE compared with the sector benchmark.

      <br>

      <strong>P/E / Valuation – 20%</strong>:
      P/E compared with the sector benchmark.
      Lower relative P/E scores better.

      <br>

      <strong>Earnings Growth – 15%</strong>:
      Latest available year-on-year net-profit growth.

      <br>

      <strong>Financial Strength – 10%</strong>:
      Balance-sheet liability-to-asset strength.

      <br>

      <strong>Profitability – 5%</strong>:
      ROA relative to the sector benchmark.

      <br><br>

      The Health Score is calculated by the StockGyan backend refresh engine
      and stored in StockGyan D1. This screener only reads stored data;
      it does not make live Upstox requests. Missing fundamental data is not treated as zero.

      <br><br>
      Strategy scans only work when their required values are present in the existing API response.
      Optional fields are displayed as unavailable when absent; the page does not infer or fabricate them.
      Quality, Value and Growth quick scans are simple convenience filters and are not investment recommendations.

    </div>

  </section>

</main>


